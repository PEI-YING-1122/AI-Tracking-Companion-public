# --- environments ---------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- machine / project specific configuration -------------------------------
configs/site.json
shots/*.json
shots/**/*.json
!shots/README.md

# --- data: never in git (test data, shot outputs, work, logs) ---------------
test_runs/
manual_qc/
work/
logs/
tests/baselines/*_raw/

# --- production / media formats ---------------------------------------------
*.exr
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.mp4
*.mov
*.abc
*.fbx
*.npz
*.ply
*.hip
*.hiplc
*.hipnc
*.nk~
*.autosave
*.db

# --- OS / editor ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# machine-specific test data location (see tests/local_test_config.example.json)
tests/local_test_config.json

# regenerated by every regression run
tests/baselines/candidate.json
# production baseline measurements are private test data (<test data>/baselines_private/)
tests/baselines/*.json
!tests/baselines/v0.2.1_intended_changes.json

# --- deployment (created per workstation / by scripts/make_release_package.py) ---
.python/
wheels/
tools/
dist/
